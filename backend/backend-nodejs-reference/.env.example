# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/academia?schema=public"

# Random 32+ character secret used to sign session JWTs
AUTH_SECRET="replace-with-a-long-random-string"

# Public URL the frontend uses to reach this API
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# File storage: "local" | "cloudinary" | "s3"
UPLOAD_PROVIDER="local"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
