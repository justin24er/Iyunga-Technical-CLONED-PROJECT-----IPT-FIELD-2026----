# Copy this file to .env and fill in real values. Never commit .env itself.

# ---- Database (MySQL / MariaDB) -------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=academia
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ---- Auth -------------------------------------------------------------------
# Random 32+ character secret used to sign session JWTs. Generate one with:
#   php -r "echo bin2hex(random_bytes(32));"
AUTH_SECRET=replace-with-a-long-random-string

# ---- App ----------------------------------------------------------------------
APP_TIMEZONE=Africa/Dar_es_Salaam
# Set to true once served over HTTPS in production, so the session cookie
# gets the Secure flag.
APP_HTTPS=false

# Comma-separated list of frontend origins allowed to call this API with
# credentials (cookies). Must be exact origins — no wildcards.
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500

# ---- File storage: "local" | "cloudinary" | "s3" ----------------------------
UPLOAD_PROVIDER=local

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
